# Supabase (para login y guardar progreso en la nube)
# Crea un proyecto en https://supabase.com y copia aquí las claves.
# Renombra este archivo a .env
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Vercel (serverless /api/gemini) — una key para todos los usuarios logueados
GEMINI_API_KEY=tu_key_de_google_ai_studio
# GEMINI_MODEL=gemini-3.5-flash-lite
# SUPABASE_URL y SUPABASE_ANON_KEY (mismos valores que arriba, sin VITE_ prefix)
